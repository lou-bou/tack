# Copy to .env and adjust.

# Port the app listens on, inside and outside the container.
PORT=8097

# Host address the port is bound to. Keep 127.0.0.1 when cloudflared runs on this machine.
BIND_ADDR=127.0.0.1

# Web Push keys. Generate them once with `npm run vapid` and keep them: changing them
# invalidates every phone's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
