# Copy to .env and adjust.

# Port the app listens on, inside and outside the container.
PORT=8097

# Host address the port is bound to. Keep 127.0.0.1 when cloudflared runs on this machine.
BIND_ADDR=127.0.0.1

# Web Push keys. Generate them once with `npm run vapid` and keep them: changing them
# invalidates every phone's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Backups. The schedule is cron syntax, in TZ.
TZ=Africa/Algiers
BACKUP_CRON=30 3 * * *
BACKUP_RETENTION_DAYS=30

# rclone remote name (from `rclone config`) and folder on it.
RCLONE_REMOTE=gdrive
RCLONE_PATH=tack-backups

# Folder holding rclone.conf on this machine. Defaults to ~/.config/rclone.
# RCLONE_CONFIG_DIR=/home/you/.config/rclone
